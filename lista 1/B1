#include <stdio.h>

int main() {
    int n;
    printf("Digite o numero de alunos: ");
    scanf("%d", &n);
    
    char nomes[n][100];
    float notas[n];
    float soma = 0;
    int aprovados = 0;
    
    for (int i = 0; i < n; i++) {
        printf("Aluno %d:\n", i + 1);
        printf("  Nome: ");
        scanf("%99s", nomes[i]);
        printf("  Nota: ");
        scanf("%f", &notas[i]);
        
        soma += notas[i];
        if (notas[i] >= 7) {
            aprovados++;
        }
    }
    
    printf("\n=== TABELA DE ALUNOS ===\n");
    printf("%-30s | Nota\n", "Nome");
    printf("-----------------------------------------\n");
    
    for (int i = 0; i < n; i++) {
        printf("%-30s | %.1f\n", nomes[i], notas[i]);
    }
    
    float media = soma / n;
    printf("\n=== RESULTADO ===\n");
    printf("Media da turma: %.1f\n", media);
    printf("Alunos aprovados: %d de %d\n", aprovados, n);
    
    return 0;
}
