#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char nome[101];
    int pontos;
} Jogador;

int main() {
    int N;
    if (scanf("%d", &N) != 1) return 0;
    if (N <= 0) return 0;
    Jogador atual;
    Jogador maior, menor;
    for (int i = 0; i < N; i++) {
        if (scanf("%100s %d", atual.nome, &atual.pontos) != 2) return 0;
        if (i == 0) {
            maior = menor = atual;
        } else {
            if (atual.pontos > maior.pontos) maior = atual;
            if (atual.pontos < menor.pontos) menor = atual;
        }
    }
    printf("Mais pontos: %s %d\n", maior.nome, maior.pontos);
    printf("Menos pontos: %s %d\n", menor.nome, menor.pontos);
    return 0;
}
