#include <stdio.h>
#include <string.h>

typedef struct {
	char nome[100];
	int idade;
	float altura;
} Pessoa;

int main() {
	Pessoa p;
	printf("Digite o nome: ");
	if (fgets(p.nome, sizeof(p.nome), stdin) == NULL) return 0;
	size_t ln = strlen(p.nome);
	if (ln > 0 && p.nome[ln-1] == '\n') p.nome[ln-1] = '\0';
	printf("Digite a idade: ");
	if (scanf("%d", &p.idade) != 1) return 0;
	printf("Digite a altura (ex: 1.75): ");
	if (scanf("%f", &p.altura) != 1) return 0;

	printf("\nFicha da Pessoa:\n");
	printf("Nome: %s\n", p.nome);
	printf("Idade: %d\n", p.idade);
	printf("Altura: %.2f m\n", p.altura);

	return 0;
}