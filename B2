#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(){
    int n;
    if(scanf("%d", &n)!=1) return 0;
    getchar();
    char **nome = malloc(n * sizeof(char*));
    double *preco = malloc(n * sizeof(double));
    int *qt = malloc(n * sizeof(int));
    double *valor = malloc(n * sizeof(double));
    for(int i=0;i<n;i++){
        nome[i] = malloc(101);
        if(!fgets(nome[i], 101, stdin)) nome[i][0]='\0';
        size_t L = strlen(nome[i]);
        if(L>0 && nome[i][L-1]=='\n') nome[i][L-1]='\0';
        scanf("%lf %d", &preco[i], &qt[i]);
        getchar();
        valor[i] = preco[i]*qt[i];
    }

    printf("Produto                      Preco   Qtde   Valor em estoque\n");
    for(int i=0;i<n;i++){
        printf("%-28s %7.2f %6d %15.2f\n", nome[i], preco[i], qt[i], valor[i]);
    }

    double total=0; int idx=0;
    for(int i=0;i<n;i++){
        total += valor[i];
        if(valor[i]>valor[idx]) idx=i;
    }
    printf("\nValor total geral: %.2f\n", total);
    if(n>0) printf("Produto com maior valor em estoque: %s (%.2f)\n", nome[idx], valor[idx]);

    for(int i=0;i<n;i++) free(nome[i]);
    free(nome); free(preco); free(qt); free(valor);
    return 0;
}
